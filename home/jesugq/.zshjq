#!/usr/bin/env bash

alias logidrld="sudo systemctl restart logid"
alias plasmarld="systemctl --user restart plasma-plasmashell.service"

# shared
function sfm() {
  somafm
}
function afk() {
  "$HOME/.script/snc"
  "$HOME/.script/afk"
}

# repos
CF_DIR=$HOME/Development/conf
function cfrld() {
  cd $CF_DIR
  sudo rsync -av etc/ /etc/
  rsync -av home/jesugq/ $HOME/
}
function cfsrc() {
  cd $CF_DIR
  source $HOME/.zshtm
  source $HOME/.zshjq
  source $HOME/.zshai
  source $HOME/.zshsp
  tmux source-file $HOME/.config/tmux/tmux.conf
}

# utils
function yz() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}
function ne() {
  nvim .
}
function lg() {
  lazygit
}
